# Copy this file to .env.local (never commit .env.local). Restart `npm run dev` after changes.
# See docs/SETUP.md and docs/PRODUCTION_DEPLOYMENT_CHECKLIST.md

# API base URL — also used for CSP connect-src at build time (no wildcards)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: your laptop LAN IP for phone testing (CSP only; API host is auto-detected on device)
# NEXT_PUBLIC_DEV_LAN_HOST=10.3.91.131

# Required for production builds (NODE_ENV=production): set to your real API origin, e.g. https://api.company.com

# Local dev only: show demo login hints on the sign-in page (Musa / Ivan / Iris accounts).
# Hints are hidden unless this is exactly "true". Must be false/unset for production builds.
NEXT_PUBLIC_SHOW_DEMO_HINTS=true
