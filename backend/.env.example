# Copy to .env (never commit .env). See docs/DEPLOYMENT.md and docs/SECURITY.md

#

# NEVER commit real secrets (API keys, JWT_SECRET, DATABASE_URL passwords).

# Use placeholders in this file only. If a secret was ever committed, rotate it

# in the provider dashboard — git history may still contain the old value.

 

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/requestflow

 

# Zamtel central staff authentication. POST /auth/login forwards { gn, password }

# to ${ZAMTEL_AUTH_BASE_URL}/api/auth/login.

ZAMTEL_AUTH_BASE_URL=http://10.3.104.141:7071

 

# Required in production: random 32+ characters (startup fails on weak defaults)

JWT_SECRET=

 

# Seconds (numeric only), e.g. 28800 = 8 hours

JWT_EXPIRES_IN=28800

PORT=4000

 

# Optional Redis cache (app works with REDIS_ENABLED=false)

REDIS_ENABLED=false

REDIS_HOST=127.0.0.1

REDIS_PORT=6379

REDIS_PASSWORD=

REDIS_DB=0

 

# Email notifications via Zamtel internal SMTP (nodemailer).

# Master switch: app works with EMAIL_ENABLED=false. When true but SMTP_HOST is

# unset, emails are logged instead of sent — handy for local dev and CI.

EMAIL_ENABLED=true

# SMTP transport. Leave SMTP_HOST blank to log emails without sending.

SMTP_HOST=webmail.zamtel.co.zm

SMTP_PORT=25

# true for implicit TLS (SMTPS, usually port 465); false for plain/STARTTLS

SMTP_SSL=false

# SMTP credentials — set in local .env only; never commit real values.

SMTP_USER=

SMTP_PASS=

# Sender shown to recipients (display name + address).

SMTP_FROM=innovation@zamtel.co.zm

SMTP_FROM_NAME=RequestFlow

 

# Optional: shared secret for unauthenticated client error ingest (header: X-Diagnostics-Ingest-Secret).

# When unset, POST /diagnostics/client-events requires a valid Bearer JWT.

# DIAGNOSTICS_INGEST_SECRET=

# User portal base URL used for "Open in RequestFlow" links in emails

APP_BASE_URL=http://localhost:3000

 

# Comma-separated portal origins (required when NODE_ENV=production; no *)

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

 

# LAN phone testing — add your laptop IPv4 (same Wi‑Fi as phone), e.g.:

# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://10.3.91.131:3000,http://10.3.91.131:3001

 

# Optional: log requests slower than SLOW_REQUEST_MS in production (no body/tokens)

# SLOW_REQUEST_LOGGING_ENABLED=true

# SLOW_REQUEST_MS=500

 

# --- Production (required) ---

# NODE_ENV=production

# ZAMTEL_AUTH_BASE_URL must be set (startup fails if missing) — it is the only

# login path in production; /auth/dev-login is hard-disabled when NODE_ENV=production.