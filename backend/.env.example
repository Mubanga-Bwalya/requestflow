# Copy to .env (never commit .env). See docs/PRODUCTION_DEPLOYMENT_CHECKLIST.md

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/requestflow

# Required in production: random 32+ characters (startup fails on weak defaults)
JWT_SECRET=

# Seconds (numeric only), e.g. 28800 = 8 hours
JWT_EXPIRES_IN=28800
PORT=4000

# Optional Redis cache (app works with REDIS_ENABLED=false)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Comma-separated portal origins (required when NODE_ENV=production; no *)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# LAN phone testing — add your laptop IPv4 (same Wi‑Fi as phone), e.g.:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://10.3.91.131:3000,http://10.3.91.131:3001

# --- Production (required) ---
# NODE_ENV=production
# ALLOW_DEMO_DEFAULT_PASSWORD must be unset or false (startup fails if true)
# ALLOW_LEGACY_PLAINTEXT_PASSWORDS must be unset or false (startup fails if true)