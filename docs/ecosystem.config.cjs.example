/**
 * PM2 ecosystem example for RequestFlow.
 * Copy to repo root as ecosystem.config.cjs and adjust cwd if needed.
 *
 *   pm2 start ecosystem.config.cjs
 *   pm2 save
 *   pm2 startup
 *
 * See docs/LOCAL_SERVER_DEPLOYMENT.md
 */
module.exports = {
  apps: [
    {
      name: "requestflow-api",
      cwd: "./backend",
      script: "dist/main.js",
      instances: 1,
      exec_mode: "fork",
      env: {
        NODE_ENV: "production",
      },
      max_memory_restart: "512M",
    },
    {
      name: "requestflow-user",
      cwd: "./user-frontend",
      script: "npm",
      args: "run start:prod",
      instances: 1,
      exec_mode: "fork",
      env: {
        NODE_ENV: "production",
        PORT: "3000",
      },
    },
    {
      name: "requestflow-admin",
      cwd: "./admin-frontend",
      script: "npm",
      args: "run start:prod",
      instances: 1,
      exec_mode: "fork",
      env: {
        NODE_ENV: "production",
        PORT: "3001",
      },
    },
  ],
};
