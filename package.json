{
  "name": "requestflow",
  "version": "0.1.0",
  "private": true,
  "description": "Internal request and progress tracking for Zamtel departments",
  "workspaces": [
    "backend",
    "user-frontend",
    "admin-frontend"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=backend",
    "dev:user": "npm run dev --workspace=user-frontend",
    "dev:admin": "npm run dev --workspace=admin-frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=backend",
    "test:e2e": "npm run test:e2e --workspace=backend",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  }
}
